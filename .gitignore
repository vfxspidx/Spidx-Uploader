# ============================================================
#  Spidx Uploader - .gitignore
# ============================================================

# --- dependencies ---------------------------------------------------
App/node_modules/

# --- runtime data: NEVER commit (tokens, secrets, user data) --------
App/incoming/
# contains the Google clientSecret
App/helper-config.json
App/google-token.json
App/license-cache.json
App/device-id.json
App/last-upload.json
App/.pending-license-code
# Playwright profile: cookies + sessions
App/browser-profile/

# --- runtime data: logs, queue, state -------------------------------
App/helper.log
App/helper-events.jsonl
App/queue.json
App/helper-state.json
App/.tray.pid
App/.skip-wizard-once

# --- generated by the app (diagnostics, update checks) --------------
App/diagnostics/
App/update-cache.json
App/plugin-updates-cache.json

# --- build output ---------------------------------------------------
Installer/Output/
VEGAS-Plugin/*.dll
VEGAS-Plugin/*.pdb

# --- OS / editor junk -----------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.swp
*.tmp