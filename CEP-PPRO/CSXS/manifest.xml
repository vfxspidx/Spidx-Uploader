<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.spidx.uploader.ppro"
                   ExtensionBundleVersion="1.0.0"
                   ExtensionBundleName="Spidx Uploader"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.spidx.uploader.ppro.panel" Version="1.0.0"/>
    </ExtensionList>

    <ExecutionEnvironment>
        <HostList>
            <!-- Premiere Pro CC 2020 (app version 14.0) is the first build with a
                 reliably scriptable Sequence.exportAsMediaDirect(), which is what
                 spidxSaveFrame() in host/spidx.jsx relies on to grab the current
                 frame. Older builds are not supported. -->
            <Host Name="PPRO" Version="[14.0,99.9]"/>
        </HostList>
        <LocaleList>
            <Locale Code="All"/>
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="8.0"/>
        </RequiredRuntimeList>
    </ExecutionEnvironment>

    <DispatchInfoList>
        <Extension Id="com.spidx.uploader.ppro.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./client/index.html</MainPath>
                    <ScriptPath>./host/spidx.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--allow-file-access</Parameter>
                        <Parameter>--allow-file-access-from-files</Parameter>
                        <!-- Same reason as the AE panel: the Leaderboard tab fetches
                             SpidxTracker's API host directly, which needs CORS
                             disabled inside CEP's embedded Chromium. -->
                        <Parameter>--disable-web-security</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>Spidx Uploader</Menu>
                    <Geometry>
                        <Size><Height>460</Height><Width>320</Width></Size>
                        <MinSize><Height>320</Height><Width>260</Width></MinSize>
                        <MaxSize><Height>1200</Height><Width>600</Width></MaxSize>
                    </Geometry>
                    <Icons>
                        <Icon Type="Normal">./icons/icon24@1x.png</Icon>
                        <Icon Type="RollOver">./icons/icon24@2x.png</Icon>
                    </Icons>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
